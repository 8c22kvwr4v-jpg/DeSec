rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {

    function isSignedIn() {
      return request.auth != null;
    }
    function isImage() {
      return request.resource.contentType.matches('image/.*');
    }
    function underLimit() {
      return request.resource.size < 12 * 1024 * 1024;
    }

    match /avvik/{reportId}/{fileName} {
      allow read: if isSignedIn();
      allow write: if isSignedIn() && isImage() && underLimit();
    }
    match /makt/{reportId}/{fileName} {
      allow read: if isSignedIn();
      allow write: if isSignedIn() && isImage() && underLimit();
    }
    match /signaturer/{fileName} {
      allow read: if isSignedIn();
      allow write: if isSignedIn() && isImage() && underLimit();
    }
  }
}
