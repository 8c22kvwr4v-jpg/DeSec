# =====================================================================
# Avero Sikkerhet - miljøvariabler
# Kopier denne filen til .env.local og fyll inn verdiene fra Supabase
# (Project settings -> API). .env.local skal ALDRI sjekkes inn.
# =====================================================================

# Adressen til Supabase-prosjektet
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxxxxxx.supabase.co

# Offentlig nøkkel (anon/publishable). Kan ligge i klientkoden.
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOi...

# Adressen appen kjører på. Brukes i lenker for nytt passord.
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ---------------------------------------------------------------------
# KUN SERVER. Må aldri eksponeres i nettleseren eller sjekkes inn.
# Brukes til å opprette og deaktivere påloggingsbrukere, og av seed-
# skriptet.
# ---------------------------------------------------------------------
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOi...
